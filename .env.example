# Nephodex — environment variables.
# Copy to `.env` for local dev (`.env` is gitignored). Never commit real tokens.
#
# The deployed Space needs NO env vars when the fine-tuned genus model is PUBLIC —
# all models load from public Hub repos and inference runs locally.

# Hugging Face token. OPTIONAL.
#   - Training/publish (Modal, push_to_hub): a WRITE token is required.
#     Prefer storing it as a Modal Secret rather than a local .env:
#       modal secret create huggingface HF_TOKEN=hf_xxx
#   - Inference: only needed if the genus model repo is PRIVATE
#     (on a Space, set it as a Space Secret instead of using this file).
HF_TOKEN=
